# ==============================================================================
# NIRIKSHAN — MPLADS Intelligence & Risk Monitoring Platform
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration (PostgreSQL with SQLite local demo fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nirikshan
SQLITE_FALLBACK_URL=sqlite:///./data/nirikshan.db
USE_SQLITE_FALLBACK=True

# Authentication & Security
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GeM (Government e-Marketplace) Price Intelligence Integration
GEM_API_KEY=your_gem_api_key_here
GEM_API_URL=https://api.gem.gov.in/v1
USE_MOCK_GEM_PROVIDER=True

# eSAKSHI & data.gov.in Ingestion Integration
ESAKSHI_API_KEY=your_esakshi_api_key_here
ESAKSHI_API_URL=https://mplads.mospi.gov.in/api/v1
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
USE_MOCK_INGESTION_PROVIDER=True

# Map Intelligence & Geocoding (Mapbox / Leaflet)
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token_here
VITE_MAPBOX_TOKEN=pk.your_mapbox_access_token_here
VITE_API_BASE_URL=http://localhost:8000/api

# Storage & Detection Engine Parameters
UPLOAD_DIR=./data/uploads
SAMPLE_DATA_DIR=./data/seed
MAX_UPLOAD_SIZE_MB=25
IMAGE_HASH_THRESHOLD=10
TEXT_SIMILARITY_THRESHOLD=0.75
GEO_PROXIMITY_KM_THRESHOLD=5.0

# Risk Engine Composite Weights (Must sum to 1.0)
WEIGHT_PRICE_BENCHMARK=0.30
WEIGHT_IQR_OUTLIER=0.20
WEIGHT_BENFORD_LAW=0.15
WEIGHT_VENDOR_HHI=0.15
WEIGHT_PHOTO_SIMILARITY=0.20
